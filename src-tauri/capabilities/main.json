{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "main-capability",
  "description": "rx0 desktop shell: window, dialog, persistence, updates, sidecar spawn",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "dialog:allow-open",
    "store:default",
    "window-state:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rx0-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
